# Vivado / Vitis generated files
/vivado/
*.Xil/
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.gen/
*.jou
*.log
*.str
*.dcp
*.bit
*.hwh
*.xsa

# 例外：上板工程本身是交付物（赛题 3.3.5.1 "上板工程"），开源仓库里必须有，
# 否则 clone 下来的人只拿到源码、board/ 是空的。体积 5 MB，可入库。
!/artifacts/hw/rtcs_system.bit
!/artifacts/hw/rtcs_system.xsa

# Software build products
build/
install/
log/
*.o
*.a
*.so

# Captures and locally measured data
data/raw/
data/captures/
*.wdb
*.vcd
*.ila

/Material_Library/

# Python / vision local environments and generated outputs
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
vision_runs/
audit_runs/

# 提交包暂存目录（scripts/package_submission.sh 生成，不入库）
/dist/

# LaTeX 中间产物：报告只提交 .tex 与 .pdf，改完连编两遍即可，中间文件不入库
docs/*.aux
docs/*.out
docs/*.toc
docs/*.log
docs/*.synctex.gz

# Vision weights require an explicit license review before distribution.
/models/vision/*.pt
!/models/vision/yolo_a_cube_cylinder_best.pt

# 内部工作日志与草稿：含队伍信息（编号/学校/姓名占位），按赛区要求不入公开仓库
/.workbuddy/
/tmp/

# 海报 PPTx 单独提交，不进代码包，也不入仓库
/docs/*.pptx
/docs/preview_*.png
/docs/images/workstation-oblique-original.jpg
/docs/images/workstation-overhead-original.jpg
